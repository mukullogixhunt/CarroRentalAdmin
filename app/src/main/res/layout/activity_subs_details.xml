<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.activity.SubsDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

     <!--   <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/white"
            app:title="@string/self_drive_subscription"
            app:titleTextColor="@color/white" />-->

        <include layout="@layout/layout_toolbar"
            android:id="@+id/toolbar"/>

        <!-- Booking Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_5sdp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_header_background_booking"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_8sdp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Booking Details"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdateStatus"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/green"
                        android:minHeight="0dp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_6sdp"
                        android:text="@string/update_status"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10ssp"
                        app:cornerRadius="@dimen/_5sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowBookingId"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowBookingStatus"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowBookingService"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowBranch"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowBookingDateTime"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowStartDateTime"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowEndDateTime"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Customer Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_5sdp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_header_background_customer"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="Customer Details"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/containerCustomerData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowCustomerName"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowCustomerMobile"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowCustomerCity"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvNoCustomerData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/_20sdp"
                    android:text="No Customer Data Available"
                    android:textColor="@color/gray_light"
                    android:textSize="@dimen/_11ssp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Car type Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_5sdp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_header_background_customer"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="Car Type Details"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/containerCarTypeData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowCarTypeName"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowDriveType"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowSeat"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowCTCarNumber"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowCtLuggage"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowCtFuel"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvNoCarTypeData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/_20sdp"
                    android:text="No Data Available"
                    android:textColor="@color/gray_light"
                    android:textSize="@dimen/_11ssp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Subscription Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_5sdp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_header_background_customer"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="Subscription Details"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/containerSubscriptionData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowSubscriptionDays"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowSubscriptionPrice"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvNoSubscriptionData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/_20sdp"
                    android:text="No Subscription Data Available"
                    android:textColor="@color/gray_light"
                    android:textSize="@dimen/_11ssp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Payment Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_5sdp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_header_background_booking"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="Payment Details"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/containerPaymentData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowBasePrice"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowFastag"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowTotal"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowAmountPaid"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowAmountRemains"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowPaymode"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowPaymentStatus"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Verification Image Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_5sdp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_header_background_booking"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="Verification Image Details"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/containerVerificationImgData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">
                    <!-- Title -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:text="Side Image"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:padding="@dimen/_10sdp"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <ImageView
                            android:id="@+id/imgSideV1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />

                        <ImageView
                            android:id="@+id/imgSideV2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />

                        <ImageView
                            android:id="@+id/imgSideV3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />

                        <ImageView
                            android:id="@+id/imgSideV4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />

                    </GridLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:text="Interior Images"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:padding="@dimen/_10sdp"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <ImageView
                            android:id="@+id/imgInteriorV1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />

                        <ImageView
                            android:id="@+id/imgInteriorV2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />
                    </GridLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:text="Meter Images"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:padding="@dimen/_10sdp"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <ImageView
                            android:id="@+id/imgMeterV1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />
                    </GridLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:text="Toolkit Images"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:padding="@dimen/_10sdp"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <ImageView
                            android:id="@+id/imgToolkitV1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />
                    </GridLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:text="Sphare Tyre Images"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:padding="@dimen/_10sdp"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <ImageView
                            android:id="@+id/imgSphareTyre"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />
                    </GridLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:text="Scratch Images"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:padding="@dimen/_10sdp"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <ImageView
                            android:id="@+id/imgScratch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:layout_margin="@dimen/_5sdp" />
                    </GridLayout>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowVRemark"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>