                    <include layout="@layout/layout_detail_row" android:id="@+id/rowInsuranceCompany"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowPolicyNumber"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowInsuranceValidUpto"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowTaxValidUpto"/>
                    <include layout="@layout/layout_detail_row" android:id="@+id/rowPuccNumber"/>
