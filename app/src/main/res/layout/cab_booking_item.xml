<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_10sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="@dimen/_10sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cdBookingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/brown"
            app:cardCornerRadius="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_minus10sdp"
            android:layout_marginEnd="@dimen/_minus10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/_20sdp"
                android:paddingTop="@dimen/_20sdp"
                android:paddingStart="@dimen/_15sdp"
                android:paddingBottom="@dimen/_9sdp"
                android:text="Pending"
                android:textStyle="bold"
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/primary_light9"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cdBookingId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary"
            app:cardCornerRadius="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_minus10sdp"
            android:layout_marginStart="@dimen/_minus10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/_20sdp"
                android:paddingTop="@dimen/_20sdp"
                android:paddingEnd="@dimen/_15sdp"
                android:paddingBottom="@dimen/_9sdp"
                android:text="# CR00031"
                android:textStyle="bold"
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/primary_light9"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1234567890"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintEnd_toStartOf="@+id/cdBookingStatus"
            app:layout_constraintStart_toEndOf="@+id/cdBookingId"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:id="@+id/llMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNumber">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/name"
                android:layout_weight="1"
                android:paddingStart="@dimen/_6sdp"
                android:layout_margin="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paid"
                    android:background="@drawable/edit_text_style"
                    android:layout_margin="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_3sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PickUp -"
                android:layout_weight="1"
                android:paddingStart="@dimen/_6sdp"
                android:layout_margin="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp" />
            <TextView
                android:id="@+id/tvReturn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Return -"
                android:layout_weight="1"
                android:paddingStart="@dimen/_6sdp"
                android:layout_margin="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oneway"
                    android:background="@drawable/edit_text_style"
                    android:layout_margin="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_3sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_11ssp" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:background="@drawable/edit_text_style"
                    android:layout_margin="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_3sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2000/-"
                    android:background="@drawable/edit_text_style"
                    android:layout_margin="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_3sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_11ssp"
                    />
                <TextView
                    android:id="@+id/tvPayMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:background="@drawable/edit_text_style"
                    android:layout_margin="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_3sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:textSize="@dimen/_11ssp"
                     />
            </LinearLayout>
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Address"
                android:layout_weight="1"
                android:paddingStart="@dimen/_6sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:layout_margin="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnAccept"
                    android:backgroundTint="@color/green"
                    android:layout_margin="@dimen/_6sdp"
                    android:text="@string/accept"/>
                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnDecline"
                    android:backgroundTint="@color/red"
                    android:layout_margin="@dimen/_6sdp"
                    android:text="@string/decline"/>
                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnForward"
                    android:backgroundTint="@color/primary_dark4"
                    android:layout_margin="@dimen/_6sdp"
                    android:text="@string/forward"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>